--- !u!114 &983604921
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 983604919}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 4beb055f07aaff244873dec698d0363e, type: 3}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uBAA8\uB4DC \uC5D0\uB514\uD130 \uC124\uBA85\n\uD574\uB2F9 \uC124\uBA85
    \uD30C\uC77C\uC740 \uBAA8\uB4DC \uC5D0\uB514\uD130 \uC6F9\uC0AC\uC774\uD2B8\uC5D0\uC11C
    \uB2E4\uC6B4\uB85C\uB4DC \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\uC6F9\uC0AC\uC774\uD2B8
    \uC8FC\uC18C : https://drivinggamemod.lovable.app\n\n\uC544\uC9C1 3D\uBAA8\uB378\uB9C1,
    \uC601\uC5B4\uC5D0 \uC775\uC219\uD558\uC2DC\uC9C0 \uC54A\uC73C\uC2E0 \uBD84\uB4E4\uC740
    ChatGPT\uB4F1\uC758 AI\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uBC1B\uC73C\uC2DC\uB294\uAC83\uC744
    \uCD94\uCC9C\uB4DC\uB9BD\uB2C8\uB2E4.\n\n\n3D\uC6B4\uC804\uAC8C\uC7844.0 \uBAA8\uB4DC
    \uC5D0\uB514\uD130\uC5D0 \uC624\uC2E0\uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!
    \uC2DC\uC791\uD558\uAE30 \uC804\uC5D0 \uBA87\uAC00\uC9C0 \uD544\uC218\uC0AC\uD56D\uC774
    \uC788\uC2B5\uB2C8\uB2E4.\n\n.glb \uD3EC\uB9F7\uC774 \uB0B4\uBCF4\uB0B4\uAE30\uAC00
    \uAC00\uB2A5\uD55C 3D\uBAA8\uB378\uB9C1 \uC18C\uD504\uD2B8\uC6E8\uC5B4 (ex \uBE14\uB79C\uB354)\n\n\uBAA8\uB4DC\uC758
    \uC6A9\uB7C9\uC740 \uB2E4\uC74C\uACFC \uAC19\uC774 \uC81C\uD55C\uB429\uB2C8\uB2E4.\n\uBA54\uBAA8\uB9AC
    4GB \uC774\uD558\uC758 \uAE30\uAE30 : 128MB\n\uBA54\uBAA8\uB9AC 4GB \uCD08\uACFC
    \uAE30\uAE30 : 512MB\n\n\uBAA8\uB4DC\uB294 \uBA40\uD2F0\uD50C\uB808\uC774\uC5D0\uC11C
    \uAC19\uC740 \uBAA8\uB4DC\uB97C \uC0AC\uC6A9\uD55C \uC720\uC800\uB07C\uB9AC\uB9CC
    \uBCF4\uC785\uB2C8\uB2E4.\n\uD604\uC7AC\uB85C\uC368\uB294 \uBAA8\uB4DC \uCC28\uB7C9\uC73C\uB85C\uB294
    \uBBF8\uC158\uBAA8\uB4DC\uAC00 \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\uBAA8\uB4DC\uB97C
    \uC801\uC6A9\uD558\uC2DC\uB824\uBA74 \uBA54\uC778\uD654\uBA74\uC758 \uD06C\uB808\uB527
    \uC0C1\uC810\uC5D0\uC11C \uBAA8\uB4DC\uCC28\uB7C9\uC744 50000\uD06C\uB808\uB527\uC5D0
    \uAD6C\uB9E4\uD574\uC57C \uD569\uB2C8\uB2E4.\n\uC774\uD6C4 \uCC28\uC120\uD0DD\uC5D0
    \uB4E4\uC5B4\uAC00\uC11C \uCD94\uAC00\uB41C \uBAA8\uB4DC\uCC28\uB7C9\uC744 \uC120\uD0DD\uD55C
    \uD6C4 \uBAA8\uB4DC \uBD88\uB7EC\uC624\uAE30 \uBC84\uD2BC\uC744 \uD1B5\uD574
    \uBAA8\uB4DC\uB97C \uC801\uC6A9\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC790\uB3D9\uCC28\uC758
    \uBAA8\uB378\uC744 \uBD88\uB7EC\uC624\uAE30 \uC804 \uBC29\uD5A5\uC740 \uC5D0\uB514\uD130
    \uBC14\uB2E5\uC5D0 \uD45C\uC2DC\uB41C \uBC29\uD5A5\uC73C\uB85C \uC218\uC815\uD574\uC8FC\uC138\uC694.\n=================================\n\uC911\uC694!\n\uBAA8\uB4DC
    \uC81C\uC791 \uBC29\uBC95 :\n\uC6B4\uC804\uAC8C\uC784 \uBAA8\uB4DC \uC5D0\uB514\uD130\uB294
    \uC790\uB3D9\uCC28\uC5D0 \uD544\uC694\uD55C \uAE30\uB2A5\uB4E4\uC744 \uBAA8\uB378\uB9C1\uB41C
    \uAC1D\uCCB4\uC758 \uC774\uB984\uC73C\uB85C \uD310\uB2E8\uD569\uB2C8\uB2E4. \uC624\uBE0C\uC81D\uD2B8\uC758
    \uAE30\uB2A5\uACFC \uADF8 \uC624\uBE0C\uC81D\uD2B8\uC5D0 \uD560\uB2F9\uD55C \uC774\uB984\uC740
    \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4.\n\n\uD544\uC218\uD56D\uBAA9  (\uD574\uB2F9
    \uD56D\uBAA9\uC774 \uC5C6\uC73C\uBA74 \uBAA8\uB4DC\uB97C \uB0B4\uBCF4\uB0BC \uC218
    \uC5C6\uC2B5\uB2C8\uB2E4.): \n\n\uC67C\uCABD \uC55E\uBC14\uD034 : Wheel_FL\n\uC624\uB978\uCABD
    \uC55E\uBC14\uD034 : Wheel_FR\n\uC67C\uCABD \uB4B7\uBC14\uD034 : Wheel_RL\n\uC624\uB978\uCABD
    \uB4B7\uBC14\uD034 : Wheel_RR\n(\uBC14\uD034\uC758 \uC911\uC2EC(pivot)\uC740
    \uBB34\uAC8C\uC911\uC2EC\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4, \uC544\uC9C1 4\uAC1C
    \uCD08\uACFC \uBC14\uD034\uB294 \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.)\n\n\uCDA9\uB3CC\uCCB4
    : Collider\n(\uCDA9\uB3CC\uCCB4\uB294 Collider 1, Collider 2 \uD615\uC2DD\uC73C\uB85C
    \uC5EC\uB7EC\uAC1C\uAC00 \uCD94\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4. \uC790\uB3D9\uCC28\uC758
    \uCC28\uCCB4\uB97C \uBCF5\uC0AC \uBD99\uC5EC\uB123\uC5B4\uC11C \uD574\uB2F9 \uC774\uB984\uC744
    \uC0AC\uC6A9\uD558\uC154\uB3C4 \uB418\uACE0 \uCD5C\uC801\uD654\uB97C \uD558\uACE0
    \uC2F6\uC73C\uC2DC\uBA74 \uC9C1\uC811 \uBE44\uC2B7\uD55C \uBAA8\uC591\uC73C\uB85C
    \uB9CC\uB4E4\uC5B4 \uD574\uB2F9 \uC774\uB984\uC744 \uBD99\uC5EC\uC8FC\uC138\uC694.)\n=================================\n\uBE44\uD544\uC218\uD56D\uBAA9
    :\n(\"\uC704\uCE58\"\uC778 \uC624\uBE0C\uC81D\uD2B8\uB4E4\uC740 \uBE48 \uC624\uBE0C\uC81D\uD2B8\uB97C
    \uC0DD\uC131\uD574 \uC704\uCE58\uB97C \uC7A1\uC544\uC8FC\uC138\uC694.)\n\n1\uC778\uCE6D
    \uCE74\uBA54\uB77C \uC704\uCE58 : Cam_FirstPerson\n\uB0B4\uBD80 \uC0AC\uB78C
    \uBAA8\uB378\uC758 \uC549\uB294 \uC704\uCE58 : Person_Position\n(\uC758\uC790\uC758
    \uAC01\uC774 \uC788\uB294 \uBD80\uBD84\uC5D0 \uC704\uCE58\uD55C \uACF3\uC5D0
    \uC911\uC559\uC758 \uBE48 \uC624\uBE0C\uC81D\uD2B8\uB97C \uD574\uB2F9 \uC774\uB984\uC73C\uB85C
    \uC0DD\uC131\uD574\uC8FC\uC138\uC694.)\n\n\uC67C\uCABD \uC0AC\uC774\uB4DC\uBBF8\uB7EC
    \uC704\uCE58 : Mirror_Left\n\uC624\uB978\uCABD \uC0AC\uC774\uB4DC\uBBF8\uB7EC
    \uC704\uCE58 : Mirror_Right\n\uBC31\uBBF8\uB7EC \uC704\uCE58 : Mirror_Back\n\n\uC8FC\uC720\uAD6C
    \uC704\uCE58 : FuelPoint\n\n\n\uCF1C\uC9C4 \uC870\uBA85\uC5D0 \uD560\uB2F9\uD560
    \uC624\uBE0C\uC81D\uD2B8\uC758 \uC774\uB984\uC744 \uB2E4\uC74C\uACFC \uAC19\uC774
    \uC124\uC815\uD574\uC8FC\uC138\uC694. \uD574\uB2F9 \uC624\uBE0C\uC81D\uD2B8\uB4E4\uC758
    \uD65C\uC131\uD654, \uBE44\uD65C\uC131\uD654\uB97C \uD1B5\uD574 \uC870\uBA85\uC774
    \uCF1C\uC9C4 \uC0C1\uD0DC\uB97C \uD45C\uD604\uD569\uB2C8\uB2E4.\n\uCF1C\uC9C4
    \uC0C1\uD0DC\uC758 \uC624\uBE0C\uC81D\uD2B8\uB4E4\uC5D0\uB294 \"Emission\"\uAC12,
    \uC0C9 \uC544\uB2C8\uBA74 \uD14D\uC2A4\uCCD0\uB97C \uC124\uC815\uD558\uC154\uC57C
    \uBE5B\uC774 \uB0A9\uB2C8\uB2E4 \uBAA8\uB4DC \uC5D0\uB514\uD130\uC5D0\uC11C \uC5BC\uB9C8\uC815\uB3C4
    \uBC1D\uAE30\uC778\uC9C0 \uD655\uC778 \uD558\uC138\uC694.\n\n\uC8FC\uAC04\uB4F1
    : Light_Run\n\uC804\uC870\uB4F1 : Light_Head\n\uBE0C\uB808\uC774\uD06C\uB4F1
    : Light_Brake\n\uD6C4\uC9C4\uB4F1 : Light_Rev\n\uC67C\uCABD \uBC29\uD5A5\uC9C0\uC2DC\uB4F1
    : Light_Left\n\uC624\uB978\uCABD \uBC29\uD5A5\uC9C0\uC2DC\uB4F1 : Light_Right\n\n\n===\uBE14\uB79C\uB354
    \uC624\uBE0C\uC81D\uD2B8 \uC911\uC2EC(pivot)\uC758 \uC124\uC815 \uBC29\uBC95\uC744
    \uAF2D \uC544\uC154\uC57C \uBB38\uC5F4\uB9BC \uAC19\uC740 \uAE30\uB2A5\uC744
    \uAD6C\uD604 \uAC00\uB2A5\uD569\uB2C8\uB2E4.===\n\n\uD578\uB4E4 3D\uC624\uBE0C\uC81D\uD2B8
    : SteeringWheel\n\n\uC67C\uCABD \uBB38 : Door_Left\n\uC624\uB978\uCABD \uBB38
    : Door_Right\n\uD2B8\uB801\uD06C : Door_Trunk\n(\uD574\uB2F9 \uC624\uBE0C\uC81D\uD2B8\uC758
    \uC911\uC2EC(pivot)\uC740 \uC624\uBE0C\uC81D\uD2B8\uAC00 \uC5B4\uB290\uACF3\uC744
    \uC911\uC2EC\uC73C\uB85C \uD68C\uC804\uD560\uC9C0 \uACB0\uC815\uD569\uB2C8\uB2E4.\n\uC608\uC2DC:
    \uBB38\uC9DD\uC758 \uACBD\uCCA9\uBD80\uBD84\uC5D0 pivot\uC744 \uC124\uC815\uD574\uC8FC\uC138\uC694)\n\n\uC2B9\uD569\uCC28,\uACE0\uC18D\uBC84\uC2A4
    \uC2AC\uB77C\uC774\uB529\uB3C4\uC5B4(\uC624\uB978\uCABD) : Door_Slide\n\n\uC2DC\uB0B4\uBC84\uC2A4\uD3F4\uB529\uB3C4\uC5B4
    \uC624\uB978\uCABD \uBB38 : BusDoor_FoldRight\n\uC2DC\uB0B4\uBC84\uC2A4\uD3F4\uB529\uB3C4\uC5B4
    \uC67C\uCABD \uBB38 : BusDoor_FoldLeft\n(\uB450\uBD80\uBD84\uC758 \uC624\uBE0C\uC81D\uD2B8\uB85C
    \uB9CC\uB4E4\uC5B4\uC57C \uC790\uB3D9\uC73C\uB85C \uD560\uB2F9\uB429\uB2C8\uB2E4.
    \uC911\uC2EC(pivot)\uC740 \uAC01\uAC01\uC758 \uBB38\uC9DD\uC758 \uAC00\uC7A5
    \uC624\uB978\uCABD\uC5D0 \uC624\uAC8C \uD574\uC8FC\uC138\uC694. \uB450 \uBB38\uC9DD\uC774
    \uB2EB\uD78C \uC0C1\uD0DC\uC5D0\uC11C\uC758 \uD68C\uC804\uC740 0,0,0 \uC774\uC5B4\uC57C
    \uD569\uB2C8\uB2E4.)\n\n\uC800\uC2F1\uBC84\uC2A4 \uC778\uD3F4\uB529 \uB3C4\uC5B4
    : BusDoor_InFold\n\n\uC2DC\uB0B4\uBC84\uC2A4 \uC2AC\uB77C\uC774\uB529\uB3C4\uC5B4
    : BusDoor_Slide\n\n\n\uBC30\uAE30\uAD6C \uC704\uCE58 : Exhaust\n(\uBC30\uAE30\uAD6C\uB294
    Exhaust 1, Exhaust 2 \uD615\uC2DD\uC73C\uB85C \uC5EC\uB7EC\uAC1C\uAC00 \uCD94\uAC00
    \uAC00\uB2A5\uD569\uB2C8\uB2E4. \uCD5C\uB300 4\uAC1C\uAE4C\uC9C0 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)\n\n\uBC88\uD638\uD310
    \uC704\uCE58 : NumberPlate\n(\uBC88\uD638\uD310\uC740 NumberPlate 1, NumberPlate
    2 \uD615\uC2DD\uC73C\uB85C 2\uAC1C\uAE4C\uC9C0 \uCD94\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)\n\n\n\n=================================\n\uCD94\uAC00\uC801\uC778
    \uBB38\uC758\uC0AC\uD56D/\uC624\uB958\uC81C\uBCF4\uB294 3ddrivinggame@gmail.com\uC73C\uB85C
    \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
